{
    "$schema": "https://www.schemastore.org/package.json",
    "private": true,
    "type": "module",
    "scripts": {
        "build": "vue-tsc && vite build",
        "dev": "vite",
        "docker:up": "docker compose -f .devcontainer/docker-compose.yml up -d",
        "docker:down": "docker compose -f .devcontainer/docker-compose.yml down",
        "docker:build": "docker compose -f .devcontainer/docker-compose.yml build",
        "docker:logs": "docker compose -f .devcontainer/docker-compose.yml logs -f",
        "docker:artisan": "docker compose -f .devcontainer/docker-compose.yml exec app php artisan",
        "docker:sh": "docker compose -f .devcontainer/docker-compose.yml exec app sh"
    },
    "devDependencies": {
        "@inertiajs/vue3": "^2.0.0",
        "@tailwindcss/forms": "^0.5.3",
        "@vitejs/plugin-vue": "^6.0.0",
        "autoprefixer": "^10.4.12",
        "concurrently": "^9.0.1",
        "laravel-vite-plugin": "^3.1",
        "postcss": "^8.4.31",
        "tailwindcss": "^3.2.1",
        "typescript": "^5.6.3",
        "vite": "^8.0.0",
        "vue": "^3.4.0",
        "vue-tsc": "^3.3.8"
    }
}
